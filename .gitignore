__pycache__/
*.pyc
.env
.env.*
!.env.example
*.egg-info/
dist/
build/
.idea/

# Binary files
*.jpg
*.jpeg
*.png
*.npy
*.log

# Whitelist catalog assets required at runtime
!lenses/catalog/images/
!lenses/catalog/images/*.jpg
!lenses/catalog/images/*.jpeg
!lenses/catalog/images/*.png

# Test output / results
**/results/
downloaded_images/

# Windows shortcuts
*.lnk

# Analysis cache (Smart Fit consistency)
face_analysis/.analysis_cache/

# pip artifacts
=*

# Local Claude Code settings (machine-specific, never commit)
.claude/settings.local.json

# Claude Code worktrees (each is its own working tree, never a submodule)
.claude/worktrees/

# Generated output (decks, build scripts, pricing maps)
out/

# Node toolchain (impeccable design tooling runs via npx; nothing is vendored)
node_modules/

# Impeccable design tooling (per-machine install: npx impeccable install --project)
.claude/skills/
.claude/agents/

# Impeccable working state (critique reports and design.json are shared; the rest is ephemeral)
.impeccable/live/
.impeccable/sketches/
.impeccable/screenshots/
.impeccable/config.local.json

# Commercial proposal (local only, never commit)
lenses_erroca_proposal.*

# Local-only AR material (never commit; kept on the owner's machine):
# the retired ar_v4 generation and the ar/modeling pipeline
/ar_v4/
/ar/modeling/

# Private verified backups and local verification receipts.
.recovery/
.pytest_cache/

# glasses3d: local data, outputs and binaries never enter Git (photos, job data,
# renders, models, .blend files). Fixture source code and JSON need no blanket re-include.
/glasses3d/data/
/glasses3d/**/output/
/glasses3d/**/dist/
/glasses3d/**/qa/output/
/glasses3d/**/.venv/
/glasses3d/**/venv/
/glasses3d/**/*.glb
/glasses3d/**/*.blend
/glasses3d/**/*.blend1
/glasses3d/**/*.webp
/glasses3d/**/*.pkl
/glasses3d/**/*.npz
/glasses3d/arview/modeling/
/glasses3d/arview/site/
/glasses3d/**/*.exr
/glasses3d/**/*.hdr
/glasses3d/**/*.tif
/glasses3d/**/*.tiff
/glasses3d/**/*.bmp
/glasses3d/**/*.gif
/glasses3d/**/*.gltf
/glasses3d/**/*.bin
/glasses3d/**/*.obj
/glasses3d/**/*.ply
/glasses3d/**/*.stl
/glasses3d/**/*.fbx
/glasses3d/**/*.mp4
/glasses3d/**/*.mov
/glasses3d/**/*.avi
