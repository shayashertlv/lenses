node_modules/
dist/
*.tsbuildinfo

# Enrollment output is biometric data. It never belongs in the repository.
# See docs/PRIVACY.md.
*.facemodel.json
fixtures/private/

# Blender extraction working files. Regenerable from the source .blend
# via .scratch/extract.py; the frame.json inside is 9 MB.
.scratch/

# Third-party browser libraries: 105,315 lines of nothing written here.
# Fetched and SHA-256 verified by scripts/fetch-vendor.mjs; versions and
# licences in ATTRIBUTION.md.
vendor/

# The repository root ignores *.jpg everywhere. These two are not photographs —
# they are the still-image source `main.ts` falls back to when there is no
# camera, and the harness fixtures. The re-include did NOT travel with the move
# from ar/, and without it a fresh clone silently loses them.
!assets/samples/*.jpg
