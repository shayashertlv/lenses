{
  "name": "ar-v4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Local eyewear try-on with accepted long-hair occlusion and preserved earlier references.",
  "scripts": {
    "dev": "vite --config vite.hair.config.ts --host 127.0.0.1 --port 8040 --strictPort",
    "dev:reference": "vite --config vite.config.ts --host 127.0.0.1 --port 8040 --strictPort",
    "check": "tsc --noEmit && tsc --noEmit -p experiments/hair-live-preview/tsconfig.json",
    "build": "npm run assets && npm run check && vite build --config vite.hair.config.ts",
    "preview": "vite preview --config vite.hair.config.ts --host 127.0.0.1 --port 8040 --strictPort",
    "preview:reference": "vite preview --config vite.config.ts --host 127.0.0.1 --port 8040 --strictPort",
    "assets": "node scripts/prepare-assets.mjs && node scripts/prepare-hair-assets.mjs",
    "test:unit": "node --test tests/unit/*.test.ts experiments/hair-live-preview/*.test.ts experiments/hair-arm-preview/compose.test.ts",
    "test:browser": "npm run build && playwright test && playwright test --config experiments/hair-live-preview/playwright.integration.config.ts",
    "test": "npm run check && npm run test:unit && npm run test:browser"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
